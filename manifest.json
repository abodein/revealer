{
  "manifest_version": 3,
  "name": "Revealer",
  "version": "0.1.0",
  "description": "Present reveal.js decks like PowerPoint: slides fullscreen on the projector, speaker view fullscreen on your screen.",
  "permissions": ["system.display", "scripting", "contentSettings", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["detect.js"], "run_at": "document_idle" }],
  "action": {
    "default_title": "Revealer: no reveal.js deck on this page",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Play the presentation" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
